# Dependencies
node_modules

# Local secrets — never commit these (secrets live in the platform Secrets page)
.env
.env.local
.env.*.local

# Build output
/dist/
/dist-ssr/
.output
.nitro
.tanstack
# Vercel Build Output API bundle (produced by build-vercel.sh at go-live).
/.vercel/

# Runtime data: the SQLite database, uploaded files and backups.
# Durable state lives OUTSIDE this folder (APPLYPILOT_DATA_DIR); this entry is
# the belt-and-braces so a stray local run can never be committed.
/data/

# Runtime server log written on start.
/.run/

# Generated by the TanStack Start router plugin on dev/build.
src/routeTree.gen.ts

# Logs and OS noise
logs
*.log
*.pid
.DS_Store
*.tsbuildinfo

# Editor
.idea/
.vscode/
